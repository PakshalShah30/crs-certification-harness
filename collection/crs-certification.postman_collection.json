                  "    pm.expect(pm.response.code, 'Expected a 4xx validation error for checkout before checkin, ' +",
                  "        'but the server accepted the booking. This is CRS-QUIRK-1 (see README).').to.be.within(400, 499);",
                  "});"
                ]
