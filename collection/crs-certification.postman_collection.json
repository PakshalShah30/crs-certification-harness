                  "});",
                  "",
                  "pm.test('QUIRK CHECK: guest_name is stored/returned without silent truncation', function () {",
                  "    const json = pm.response.json();",
                  "    const submitted = JSON.parse(pm.request.body.raw).guest_name;",
